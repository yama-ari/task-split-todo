<div class="flex items-start gap-3 group w-full relative overflow-visible">
  <!-- ✅ チェックボタン（ホバーで表示） -->
  <%= form_with url: update_status_task_path(task), method: :patch, local: false  do %>
    <%= hidden_field_tag "task[is_done]", "closed" %>
    <button type="submit"
            class="mt-2 text-gray-400 hover:text-green-600 transition group-hover:opacity-100 opacity-0 tooltip z-50"
            data-tip="完了にする">
      <span class="inline-block w-4 h-4 text-xl relative">
        <span class="absolute left-full inset-0 transition-opacity duration-200 opacity-0 group-hover:opacity-100">□</span>
      </span>
    </button>
  <% end %>

  <!-- ✅ 本文 -->
  <div class="flex-1 w-full">
    <p class="text-base font-semibold text-gray-800"><%= task.title %></p>

    <% if task.memo.present? %>
      <p class="text-sm text-gray-600 mt-1"><%= task.memo %></p>
    <% else %>
      <p class="text-sm text-gray-600 mt-1 invisible"></p>
    <% end %>

    <% if task.estimated_time.present? %>
      <p class="text-xs text-gray-400 mt-1"><%= "#{task.estimated_time}分" %></p>
    <% else %>
      <p class="text-sm text-gray-600 mt-1 invisible"></p>
    <% end %>
  </div>
</div>
